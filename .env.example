# Copia este archivo a .env.local y rellena los valores reales.
# Los encuentras en Supabase: Project Settings -> API.
# .env.local NUNCA se commitea.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo para scripts de servidor (seed). JAMAS exponer al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Secreto compartido de la ingesta de formularios (POST /api/formularios).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
FORMULARIOS_WEBHOOK_SECRET=

# Secreto del motor de alertas (POST /api/tareas-programadas)
# Genera uno con: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# Envio de correo (opcional). Sin esto los avisos quedan solo en la campana de la app.
RESEND_API_KEY=
EMAIL_REMITENTE=
NEXT_PUBLIC_URL_APP=http://localhost:3000

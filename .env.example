# Copia este archivo a .env.local y rellena los valores reales.
# Los encuentras en Supabase: Project Settings -> API.
# .env.local NUNCA se commitea.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo para scripts de servidor (seed). JAMAS exponer al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Secreto compartido de la ingesta de formularios (POST /api/formularios).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
FORMULARIOS_WEBHOOK_SECRET=

# Secreto del motor de alertas (POST /api/tareas-programadas)
# Genera uno con: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# Envio de correo (opcional). Sin esto los avisos quedan solo en la campana de la app.
RESEND_API_KEY=
EMAIL_REMITENTE=
NEXT_PUBLIC_URL_APP=http://localhost:3000

# ---------------------------------------------------------------------------
# FASE 2 EN ADELANTE. Todo lo de abajo es OPCIONAL: sin ello la plataforma
# funciona, solo que la funcionalidad correspondiente queda apagada y lo dice
# en su pantalla.
# ---------------------------------------------------------------------------

# Asistente de IA (area clinica, copiloto de direccion, resumen de caso).
# Ademas hay que encenderlo en Administracion -> Parametros, y conviene
# hacerlo solo tras firmar el acuerdo de tratamiento de datos con el proveedor.
ANTHROPIC_API_KEY=

# Notificaciones push en el movil. Genera el par con: npm run push:claves
# Cambiarlas invalida todas las suscripciones existentes.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# WhatsApp Business API (Meta). El webhook es /api/whatsapp.
# Sin APP_SECRET la ruta rechaza todo: un webhook abierto que crea leads es
# una puerta para llenar el CRM de basura.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Zerochats (Instagram de Lolo Drago). Mientras no haya clave, esos leads se
# siguen registrando a mano en la bandeja de grupo.
ZEROCHATS_API_KEY=

# Google Calendar (complemento; la agenda de referencia es la de la plataforma).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Monitorizacion de errores. Sin DSN no se inicializa nada y no sale ni un byte.
SENTRY_DSN=

    "@supabase/supabase-js": "^2.112.4",
    "@types/web-push": "^3.6.4",
    "cmdk": "^1.1.1",
    "next": "15.5.24",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",

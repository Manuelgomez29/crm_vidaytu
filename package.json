    "verificar:seguridad": "tsx --env-file=.env.local scripts/verificar-seguridad.ts",
    "staging:seed": "tsx --env-file=.env.staging scripts/seed.ts",
    "staging:verificar": "tsx --env-file=.env.staging scripts/verificar.ts",
    "staging:verificar:muro": "node --env-file=.env.staging scripts/verificar-muro.mjs",
